#!/usr/bin/env bash
# Generated single-file installer. Run with bash, without sudo.
set -euo pipefail
expected_version=20250330
map_sha='@MAP_SHA@'
app_id=command-and-conquer-omarchy
mode=install
case "${1:-}" in
  '') ;;
  --no-launch) mode=no-launch ;;
  --uninstall) mode=uninstall ;;
  --help) echo "Usage: bash $0 [--no-launch | --uninstall]"; exit 0 ;;
  *) echo "Unknown option: $1" >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { echo 'Only one option is supported.' >&2; exit 2; }
[[ $(id -u) != 0 ]] || { echo 'Run this as your normal user, without sudo.' >&2; exit 1; }
app_dir="${XDG_DATA_HOME:-$HOME/.local/share}/$app_id"
applications="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
if [[ $mode == uninstall ]]; then
  [[ -f "$app_dir/uninstall.sh" ]] || { echo 'No single-installer installation found.'; exit 0; }
  exec bash "$app_dir/uninstall.sh"
fi
command -v pacman >/dev/null || { echo 'This installer targets Omarchy / Arch Linux.' >&2; exit 1; }
[[ $(uname -m) == x86_64 ]] || { echo 'This build targets your x86_64 Omarchy PC.' >&2; exit 1; }
# Verify the embedded map before installing any dependencies or changing user files.
staging=$(mktemp -d)
trap 'rm -rf -- "$staging"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
sed '1,/^__OMARCHY_PAYLOAD__$/d' "$0" | base64 --decode > "$staging/map.oramap"
printf '%s  %s\n' "$map_sha" "$staging/map.oramap" | sha256sum --check --status || {
  echo 'Installer payload is damaged. Download it again.' >&2; exit 1;
}
if ! pacman -Q openra >/dev/null 2>&1; then
  echo 'Installing OpenRA from your configured Arch repositories (sudo may ask for your password).'
  sudo pacman -S --needed openra
fi
installed=$(pacman -Q openra)
version=${installed#* }
version=${version#*:}
[[ ${version%-*} == "$expected_version" ]] || {
  echo "This skirmish requires OpenRA $expected_version; installed: $installed." >&2
  echo 'No game files changed. Use a matching installer; OpenRA was not downgraded.' >&2
  exit 1
}
command -v openra-ra >/dev/null || { echo 'OpenRA Red Alert launcher is missing. Repair the openra package.' >&2; exit 1; }
map_dir="${XDG_CONFIG_HOME:-$HOME/.config}/openra/maps/ra/release-$expected_version"
[[ ! -d "$HOME/.openra" ]] || map_dir="$HOME/.openra/maps/ra/release-$expected_version"
# Reinstalls keep managing the original location, even if XDG_CONFIG_HOME changes.
[[ ! -f "$app_dir/map-path" ]] || map_dir=$(dirname -- "$(cat "$app_dir/map-path")")
map_path="$map_dir/omarchy-skirmish.oramap"
mkdir -p -- "$app_dir" "$applications" "$map_dir"
# Preserve the pre-installer map once, across reinstalls and upgrades.
if [[ ! -f "$app_dir/map-path" ]]; then
  if [[ -e "$map_path" || -L "$map_path" ]]; then
    cp -p -- "$map_path" "$app_dir/previous.oramap"
  fi
  printf '%s\n' "$map_path" > "$app_dir/map-path"
fi
atomic_install() {
  local tmp
  tmp=$(mktemp "${2}.XXXXXX")
  if install -m "$3" -- "$1" "$tmp" && mv -f -- "$tmp" "$2"; then return 0; fi
  rm -f -- "$tmp"
  return 1
}
atomic_install "$staging/map.oramap" "$map_path" 644
printf '%s\n' "$map_sha" > "$app_dir/map-sha256"
cat > "$staging/launch.sh" <<'LAUNCH'
#!/usr/bin/env bash
set -euo pipefail
installed=$(pacman -Q openra 2>/dev/null || true)
version=${installed#* }; version=${version#*:}
if [[ ${version%-*} != 20250330 ]]; then
  message='This Omarchy skirmish needs OpenRA 20250330. Install a matching build before playing.'
  if command -v zenity >/dev/null; then zenity --error --text="$message"; else echo "$message" >&2; fi
  exit 1
fi
exec openra-ra "$@"
LAUNCH
atomic_install "$staging/launch.sh" "$app_dir/launch.sh" 755
# Desktop Exec uses its own escaping, distinct from shell quoting.
desktop_path=${app_dir//\\/\\\\}
desktop_path=${desktop_path//\"/\\\"}
desktop_path=${desktop_path//\$/\\\$}
desktop_path=${desktop_path//\`/\\\`}
desktop_path=${desktop_path//%/%%}
cat > "$staging/game.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Command & Conquer: Omarchy Edition
Comment=Build a base and battle The Walled Garden in Package Conflict
Exec="$desktop_path/launch.sh"
Icon=openra-ra
Terminal=false
Categories=Game;StrategyGame;
Keywords=Omarchy;OpenRA;Skirmish;
DESKTOP
atomic_install "$staging/game.desktop" "$applications/$app_id.desktop" 644
# Capture the exact installation paths; removal never searches other OpenRA data.
{
  printf '#!/usr/bin/env bash\nset -euo pipefail\napp_dir=%q\ndesktop=%q\n' "$app_dir" "$applications/$app_id.desktop"
  cat <<'REMOVE'
[[ $(id -u) != 0 ]] || { echo 'Run without sudo.' >&2; exit 1; }
map_path=$(cat "$app_dir/map-path")
sha=$(cat "$app_dir/map-sha256")
if [[ -e "$map_path" ]]; then
  if ! printf '%s  %s\n' "$sha" "$map_path" | sha256sum --check --status; then
    echo "Map changed since installation; keeping it and the backup. Move it aside and retry: $map_path" >&2
    exit 1
  fi
  rm -- "$map_path"
fi
if [[ -f "$app_dir/previous.oramap" ]]; then
  cp -p -- "$app_dir/previous.oramap" "$map_path"
fi
rm -f -- "$desktop" "$app_dir/launch.sh" "$app_dir/map-path" "$app_dir/map-sha256" "$app_dir/previous.oramap" "$app_dir/uninstall.sh"
rmdir -- "$app_dir" 2>/dev/null || true
command -v update-desktop-database >/dev/null && update-desktop-database "$(dirname -- "$desktop")" || true
echo 'Removed Omarchy Edition. OpenRA, its content, saves and other maps were kept.'
REMOVE
} > "$staging/uninstall.sh"
atomic_install "$staging/uninstall.sh" "$app_dir/uninstall.sh" 755
command -v update-desktop-database >/dev/null && update-desktop-database "$applications" || true
echo 'Installed Command & Conquer: Omarchy Edition in your app menu.'
echo 'First launch: let OpenRA install Red Alert content if prompted.'
echo 'Then choose Singleplayer → Skirmish → Omarchy Skirmish - Package Conflict.'
echo 'Take the green slot and add Normal AI to the pink Walled Garden slot.'
printf 'Uninstall: bash %q\n' "$app_dir/uninstall.sh"
if [[ $mode == install ]]; then
  "$app_dir/launch.sh"
fi
exit 0
__OMARCHY_PAYLOAD__
