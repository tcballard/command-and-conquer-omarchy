#!/usr/bin/env bash
# Complete user-local Omarchy Edition bundle. No system OpenRA dependency.
set -euo pipefail
payload_sha='@PAYLOAD_SHA@'
app_id=command-and-conquer-omarchy
mode=install
case "${1:-}" in
  '') ;;
  --no-launch) mode=no-launch ;;
  --uninstall) mode=uninstall ;;
  --help) echo "Usage: bash $0 [--no-launch | --uninstall]"; exit 0 ;;
  *) echo "Unknown option: $1" >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { echo 'Only one option is supported.' >&2; exit 2; }
[[ $(id -u) != 0 ]] || { echo 'Run this as your normal user, without sudo.' >&2; exit 1; }
app_dir="${XDG_DATA_HOME:-$HOME/.local/share}/$app_id"
applications="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
if [[ $mode == uninstall ]]; then
  [[ -f "$app_dir/uninstall.sh" ]] || { echo 'No bundled installation found.'; exit 0; }
  exec bash "$app_dir/uninstall.sh"
fi
[[ $(uname -m) == x86_64 ]] || { echo 'This bundle requires x86_64 Linux.' >&2; exit 1; }
staging=$(mktemp -d)
trap 'rm -rf -- "$staging"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
sed '1,/^__OMARCHY_PAYLOAD__$/d' "$0" | base64 --decode > "$staging/payload.tar.gz"
printf '%s  %s\n' "$payload_sha" "$staging/payload.tar.gz" | sha256sum --check --status || {
  echo 'Installer payload is damaged. Download it again.' >&2; exit 1;
}
tar -xzf "$staging/payload.tar.gz" -C "$staging"
(cd "$staging/engine" && sha256sum --check --status SHA256SUMS)
# Test the actual bundled engine and every custom faction image before activation.
(cd "$staging/engine" && ENGINE_DIR="$staging/engine" MOD_SEARCH_PATHS="$staging/engine/mods" ./OpenRA.Utility omarchy --check-omarchy)
version=$(cat "$staging/engine/OMARCHY_VERSION")
[[ $version =~ ^v[0-9A-Za-z.-]+$ ]] || { echo 'Invalid bundle version.' >&2; exit 1; }
mkdir -p "$app_dir/releases" "$app_dir/support" "$applications"
# Reuse an existing content download, but never put another map into stock Red Alert.
if [[ ! -e "$app_dir/support/Content" && ! -L "$app_dir/support/Content" ]]; then
  for candidate in "${XDG_CONFIG_HOME:-$HOME/.config}/openra/Content" "$HOME/.openra/Content"; do
    if [[ -d $candidate ]]; then ln -s "$candidate" "$app_dir/support/Content"; break; fi
  done
fi
# Unique immutable directory + atomic pointer means a failed install retains the old build.
release_dir=$(mktemp -d "$app_dir/releases/$version.XXXXXX")
cp -a "$staging/engine/." "$release_dir/"
(cd "$release_dir" && sha256sum --check --status SHA256SUMS)
ln -s "$release_dir" "$app_dir/current.new"
mv -Tf "$app_dir/current.new" "$app_dir/current"
cat > "$staging/launch.sh" <<'LAUNCH'
#!/usr/bin/env bash
set -euo pipefail
app_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
engine_dir=$(readlink -f "$app_dir/current")
# The content downloader may restart into either of these two mods only.
for arg in "$@"; do
  case "$arg" in
    Game.Mod=omarchy|Game.Mod=omarchy-content) ;;
    Game.Mod=*|Engine.*) echo "Unsupported launch override: $arg" >&2; exit 2 ;;
  esac
done
cd "$engine_dir"
export ENGINE_DIR="$engine_dir" MOD_SEARCH_PATHS="$engine_dir/mods"
if [[ ${1:-} == --verify ]]; then
  sha256sum --check --status SHA256SUMS
  exec ./OpenRA.Utility omarchy --check-omarchy
fi
# OpenRA restores the last skirmish faction even when the map fixes player slots.
# Migrate an existing lobby choice so the human always starts as Omarchy.
skirmish="$app_dir/support/skirmish.omarchy.yaml"
if [[ -f $skirmish ]]; then
  sed -i '/^Player: Multi0$/,/^Bots:/ s/^[[:space:]]*Faction: [^[:space:]]\+$/\tFaction: allies/' "$skirmish"
fi
printf 'Starting Omarchy Edition %s (bundled engine)\n' "$(cat OMARCHY_VERSION)"
exec ./OpenRA Game.Mod=omarchy "Engine.ModSearchPaths=$engine_dir/mods" \
  "Engine.LaunchPath=$app_dir/launch.sh" "Engine.SupportDir=$app_dir/support" \
  Game.FetchNews=false Game.AllowDownloading=false Debug.CheckVersion=false "$@"
LAUNCH
install -m755 "$staging/launch.sh" "$app_dir/launch.sh"
desktop_path=${app_dir//\\/\\\\}
desktop_path=${desktop_path//\"/\\\"}
desktop_path=${desktop_path//\$/\\\$}
desktop_path=${desktop_path//\`/\\\`}
desktop_path=${desktop_path//%/%%}
cat > "$applications/$app_id.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Command & Conquer: Omarchy Edition
Comment=Bundled Omarchy skirmish — custom units vs The Walled Garden
Exec="$desktop_path/launch.sh"
Icon=$app_dir/current/mods/omarchy/omarchy-icon.png
Terminal=false
Categories=Game;StrategyGame;
Keywords=Omarchy;Package Conflict;
DESKTOP
# Keep the legacy map backup/remover available without invoking it automatically.
if [[ -f "$app_dir/map-path" && -f "$app_dir/uninstall.sh" && ! -f "$app_dir/uninstall-legacy.sh" ]]; then
  cp "$app_dir/uninstall.sh" "$app_dir/uninstall-legacy.sh"
fi
{
  printf '#!/usr/bin/env bash\nset -euo pipefail\napp_dir=%q\ndesktop=%q\n' "$app_dir" "$applications/$app_id.desktop"
  cat <<'REMOVE'
[[ $(id -u) != 0 ]] || { echo 'Run without sudo.' >&2; exit 1; }
rm -f -- "$desktop" "$app_dir/launch.sh" "$app_dir/current" "$app_dir/uninstall.sh"
rm -rf -- "$app_dir/releases"
echo 'Removed the bundled game. Content, saves and any older OpenRA installation were kept.'
REMOVE
} > "$app_dir/uninstall.sh"
chmod 755 "$app_dir/uninstall.sh"
command -v update-desktop-database >/dev/null && update-desktop-database "$applications" || true
echo "Installed bundled Omarchy Edition $version; all 91 faction roster entries verified."
echo 'First launch may ask to download Red Alert terrain and sounds.'
printf 'Launch: bash %q\n' "$app_dir/launch.sh"
if [[ $mode == install ]]; then "$app_dir/launch.sh"; fi
exit 0
__OMARCHY_PAYLOAD__
