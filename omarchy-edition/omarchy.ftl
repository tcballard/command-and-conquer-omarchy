## Red Alert: Omarchy Edition -- map-level strings.
## Keys are deliberately prefixed so they cannot collide with the mod bundle
## (the engine gives mod-level keys priority over map-level keys).

## Faction display names
faction-omarchians =
    .name = Omarchians

faction-commies =
    .name = The Commies

## Omarchian structures
omarchy-fact =
    .name = The ISO
    .description = Everything is built from here. Do not rm -rf.

omarchy-powr =
    .name = Hyprland Compositor
    .description = Powers all windows. Tiling only.

omarchy-proc =
    .name = pacman Cache
    .description = Syncs the ore database.

omarchy-tent =
    .name = Waybar
    .description = Trains status-bar operatives.

omarchy-weap =
    .name = Neovim Foundry
    .description = Ships armour in modal form.

omarchy-pdox =
    .name = omarchy-update
    .description = Teleports units to the latest release.

